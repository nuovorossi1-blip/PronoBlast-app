{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "dub1"
  ],
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build:web",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/predict"
    },
    {
      "source": "/matches-list",
      "destination": "/api/matches-list"
    },
    {
      "source": "/matches-days",
      "destination": "/api/matches-days"
    },
    {
      "source": "/match-detail",
      "destination": "/api/match-detail"
    },
    {
      "source": "/match-result",
      "destination": "/api/match-result"
    },
    {
      "source": "/upload-excel",
      "destination": "/api/upload-excel"
    },
    {
      "source": "/upload-skipped",
      "destination": "/api/upload-skipped"
    },
    {
      "source": "/ai-predict",
      "destination": "/api/ai-predict"
    },
    {
      "source": "/llm-settings",
      "destination": "/api/llm-settings"
    },
    {
      "source": "/budget",
      "destination": "/api/budget"
    },
    {
      "source": "/ml-stats",
      "destination": "/api/ml-stats"
    },
    {
      "source": "/selection-update",
      "destination": "/api/selection-update"
    },
    {
      "source": "/selected-list",
      "destination": "/api/selected-list"
    },
    {
      "source": "/selection-clear",
      "destination": "/api/selection-clear"
    },
    {
      "source": "/export-db",
      "destination": "/api/export-db"
    },
    {
      "source": "/import-db",
      "destination": "/api/import-db"
    },
    {
      "source": "/delete-all",
      "destination": "/api/delete-all"
    },
    {
      "source": "/match-candidates",
      "destination": "/api/match-candidates"
    },
    {
      "source": "/match-history",
      "destination": "/api/match-history"
    },
    {
      "source": "/results-apply",
      "destination": "/api/results-apply"
    },
    {
      "source": "/results-bulk",
      "destination": "/api/results-bulk"
    },
    {
      "source": "/stats-scores",
      "destination": "/api/stats-scores"
    },
    {
      "source": "/stats-reset",
      "destination": "/api/stats-reset"
    },
    {
      "source": "/aistudio-prompt",
      "destination": "/api/aistudio-prompt"
    },
    {
      "source": "/results-fetch",
      "destination": "/api/results-fetch"
    },
    {
      "source": "/save-verdict",
      "destination": "/api/save-verdict"
    },
    {
      "source": "/build-multipla",
      "destination": "/api/build-multipla"
    },
    {
      "source": "/db-stats",
      "destination": "/api/db-stats"
    },
    {
      "source": "/pending-matches",
      "destination": "/api/pending-matches"
    },
    {
      "source": "/results-import",
      "destination": "/api/results-import"
    },
    {
      "source": "/sync-results",
      "destination": "/api/sync-results"
    },
    {
      "source": "/rebuild-learning",
      "destination": "/api/rebuild-learning"
    },
    {
      "source": "/similar-odds",
      "destination": "/api/similar-odds"
    },
    {
      "source": "/web-probe",
      "destination": "/api/web-probe"
    },
    {
      "source": "/af-probe",
      "destination": "/api/af-probe"
    },
    {
      "source": "/backtest",
      "destination": "/api/backtest"
    },
    {
      "source": "/apif-probe",
      "destination": "/api/apif-probe"
    },
    {
      "source": "/odd-settings",
      "destination": "/api/odd-settings"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
